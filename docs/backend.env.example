# =============================================================================
# Backend + DB (template) — copy to your API repo as .env or .env.local
# Koyeb: set these in the service Environment tab (do not commit real values).
# =============================================================================

# HTTP bind (local dev). Koyeb sets PORT automatically — use process.env.PORT in code.
HOST=0.0.0.0
PORT=8000

# Database (adjust driver/name for your stack)
# Examples:
#   DATABASE_URL=postgresql://user:pass@localhost:5432/nudge
#   DATABASE_URL=sqlite:///./nudge.db
DATABASE_URL=

# OpenAI (server only — never expose in frontend)
OPENAI_API_KEY=
# Optional: OPENAI_PROJECT=proj_...

# CORS: SPA / WebView origins (comma-separated). Must match the request Origin header exactly.
# Web: CRA dev server
# Capacitor: iOS WKWebView often sends capacitor://localhost; Android may send https://localhost (see capacitor.config server.androidScheme)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,ionic://localhost,https://localhost
