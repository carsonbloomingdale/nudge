# API origin (no trailing slash). Must match CORS + cookie Domain/SameSite on the server.
REACT_APP_API_BASE_URL=http://127.0.0.1:8000

# When true (dev only), this OVERRIDES REACT_APP_API_BASE_URL: requests go to the CRA dev
# server origin (e.g. localhost:3000) and package.json "proxy" forwards to the backend.
# The browser Network tab will show :3000, not :8000. Use for CORS/cookie issues; otherwise
# leave unset/false so the browser calls REACT_APP_API_BASE_URL directly.
# REACT_APP_USE_SAME_ORIGIN_API=true

# Dev server (npm start only)
# HOST=0.0.0.0
# PORT=3000
