{
  "name": "nudge",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/ios": "^8.2.0",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/push-notifications": "^8.0.2",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.7.2",
    "debounce": "^2.1.0",
    "moment": "^2.30.1",
    "prettier": "^3.3.0",
    "react": "^18.3.1",
    "react-cookie": "^7.1.4",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "react-scripts": "^5.0.1",
    "serve": "^14.2.4",
    "styled-components": "^6.1.11",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5"
  },
  "proxy": "http://127.0.0.1:8000",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "react-scripts start",
    "start": "serve -s build -l tcp://0.0.0.0:${PORT:-3000}",
    "build": "GENERATE_SOURCEMAP=false react-scripts build",
    "mobile:sync": "bun run build && bunx cap sync",
    "mobile:ios": "bunx cap open ios",
    "mobile:android": "bunx cap open android",
    "mobile:run:ios": "bun run mobile:sync && bunx cap run ios",
    "mobile:run:android": "bun run mobile:sync && bunx cap run android",
    "test": "react-scripts test",
    "test:bun": "bun test ./tests/bun",
    "eject": "react-scripts eject"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@happy-dom/global-registrator": "^20.8.9"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
