# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/nudge/node_modules
/nudge/.env
/.pnp
.pnp.js

# testing
/coverage
nudge/coverage

# production
/build
nudge/build

# misc
.DS_Store
Thumbs.db
*.log
*.pem

# Bun (local cache / install metadata — never commit)
.bun/
nudge/.bun/
node_modules/.bun/
nudge/node_modules/.bun/

# Local reliability cron (not part of the app; copy to ~/Desktop if desired)
/desktop-reliability-agent/

# Editor / OS
.idea/

# Env / secrets (never commit real values; commit nudge/.env.example only)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
nudge/.env
nudge/.env.local
nudge/.env.development.local
nudge/.env.test.local
nudge/.env.production.local

# CRA app under nudge/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*
